# PlatformIO build output
.pio

# Editor and IDE state. Everything here is rewritten per machine or per tool
# version rather than configured for this project, and the two JSON files below
# embed absolute paths that only resolve on one box.
.idea/
.vscode/c_cpp_properties.json
.vscode/launch.json
/.fleet/settings.json
/.serena/

# graphify output, caches and converted sidecars
graphify-out/

# Frame recordings for the web player. Generated by `--dump-frames`, several
# hundred KB of binary, and reproducible byte for byte from the firmware, so
# they are built in the Pages workflow rather than committed and reviewed.
web/data/

# Incremental WebAssembly object cache, written by tools/build-wasm.sh. Keyed to
# the source tree it was built from, so it is machine state, not a source.
web/live/.obj/

# The WebAssembly module and its glue. Generated from src/ by
# tools/build-wasm.sh, about 180 KB of binary, and rebuilt by CI and by the Pages
# workflow, so committing it would only add a copy that drifts from the source it
# was built from. The page needs it to exist, so the live view 404s until the
# script has been run once.
web/live/glitchglimmer.js
web/live/glitchglimmer.wasm

# Build stamp, written by tools/build-wasm.sh so an open page can tell that the
# module it loaded has been replaced and reload itself. Present only in a working
# copy, which is also what keeps the page's polling off a deployed one.
web/live/build.json

# Local harness and build logs
sim-run.txt
*.log

# The root package.json carries the `npm start` static server and nothing else
# depends on it, so this is only here to catch an install that a stray
# dependency would otherwise leave untracked.
node_modules/

# Microphone captures from the live page's Record button. Float samples of
# whatever was in the room, which is the user's environment rather than the
# project's source, and the harness generates its own fixtures for the checks.
*.f32
.tools/
