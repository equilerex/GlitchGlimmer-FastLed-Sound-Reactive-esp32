{
  "name": "glitchglimmer",
  "version": "0.0.0",
  "private": true,
  "description": "Sound-reactive LED firmware. This manifest exists only to run the browser visualiser in web/ -- the firmware builds with PlatformIO and the WebAssembly with tools/build-wasm.sh.",
  "scripts": {
    "start": "node tools/serve-web.js",
    "frames": "node tools/dump-frames.js",
    "native": "node tools/run-native.js",
    "wasm": "node tools/run-wasm.js",
    "build:dist": "node tools/build-dist.js",
    "setup:hooks": "node tools/install-hooks.js",
    "setup": "node tools/setup.js",
    "setup:native": "node tools/setup-native.js",
    "setup:wasm": "node tools/setup-emscripten.js",
    "test": "node --test \"test/**/*.test.js\"",
    "upload": "pio run -e esp32s3 -t upload --upload-port COM9"
  },
  "engines": {
    "node": ">=22"
  }
}
