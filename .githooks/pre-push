#!/usr/bin/env sh
set -eu

if [ ! -f dist/index.html ]; then
  echo >&2
  echo "dist/ is missing. Run npm run build:dist and commit the bundle." >&2
  exit 1
fi

if [ -n "$(git status --short -- dist)" ]; then
  echo >&2
  echo "dist/ has uncommitted changes." >&2
  echo "Run npm run build:dist, commit the refreshed bundle, then push again." >&2
  exit 1
fi
